{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with study stats, tickets, and customization settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the user",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the coworker",
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 120
        },
        "tickets": {
          "type": "number",
          "description": "Earned cafe tickets"
        },
        "totalMinutesFocused": {
          "type": "number",
          "description": "Total focused study minutes"
        },
        "currentActivity": {
          "type": "string",
          "description": "Current status activity string",
          "maxLength": 80
        },
        "avatarConfigJson": {
          "type": "string",
          "description": "Serialized JSON string of the user avatar configuration",
          "maxLength": 2048
        },
        "deskConfigJson": {
          "type": "string",
          "description": "Serialized JSON string of desk workstation accessories",
          "maxLength": 2048
        },
        "unlockedItemsJson": {
          "type": "string",
          "description": "Serialized JSON string of unlocked shop items",
          "maxLength": 4096
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp when the user profile was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp when the user profile was last updated"
        }
      },
      "required": ["userId", "displayName", "tickets", "totalMinutesFocused"]
    },
    "BookshelfItem": {
      "title": "Bookshelf Item",
      "description": "Books saved, marked as reading or completed, along with reader notes and bookmarks",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the owner",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookId": {
          "type": "number",
          "description": "Project Gutenberg book ID number"
        },
        "title": {
          "type": "string",
          "description": "Title of the book",
          "maxLength": 150
        },
        "author": {
          "type": "string",
          "description": "Author of the book",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Genre or category of the book",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "description": "Reading progress status",
          "enum": ["want_to_read", "reading", "completed"],
          "maxLength": 20
        },
        "notes": {
          "type": "string",
          "description": "Personal reader notes, favorite quotes, or study thoughts",
          "maxLength": 2000
        },
        "claimedBonus": {
          "type": "boolean",
          "description": "Whether completion bonus tickets were claimed"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when this bookshelf entry was updated"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when this bookshelf entry was created"
        }
      },
      "required": ["userId", "bookId", "title", "author", "status"]
    },
    "CafeSharedNote": {
      "title": "Cafe Shared Note",
      "description": "Public sticky notes and book recommendations on the cafe community board",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the author",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "Text content of the note",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "description": "Category tag for the recommendation or thought",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when this note was posted"
        }
      },
      "required": ["userId", "authorName", "text"]
    },
    "RoomPresence": {
      "title": "Room Presence",
      "description": "Real-time presence of a user in a specific room and server instance with assigned desk",
      "type": "object",
      "properties": {
        "presenceId": {
          "type": "string",
          "description": "Composite key {roomId}_{userId}",
          "maxLength": 160
        },
        "roomId": {
          "type": "string",
          "description": "Unique room server ID",
          "maxLength": 80
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of the coworker",
          "maxLength": 80
        },
        "avatarConfigJson": {
          "type": "string",
          "description": "Serialized JSON avatar config",
          "maxLength": 2048
        },
        "deskConfigJson": {
          "type": "string",
          "description": "Serialized JSON desk config",
          "maxLength": 2048
        },
        "deskIndex": {
          "type": "number",
          "description": "Assigned cubicle desk slot 1 to 5"
        },
        "currentTask": {
          "type": "string",
          "description": "Current task title",
          "maxLength": 120
        },
        "focusMinutesToday": {
          "type": "number",
          "description": "Focus minutes today"
        },
        "tickets": {
          "type": "number",
          "description": "Current ticket count"
        },
        "reactionEmoji": {
          "type": "string",
          "description": "Active floating reaction emoji",
          "maxLength": 20
        },
        "reactionTimestamp": {
          "type": "number",
          "description": "Reaction timestamp ms"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp for presence heartbeat"
        }
      },
      "required": ["presenceId", "roomId", "userId", "userName", "deskIndex"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Coworker friends list connection",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Current user ID",
          "maxLength": 128
        },
        "friendUserId": {
          "type": "string",
          "description": "Friend's user ID",
          "maxLength": 128
        },
        "friendName": {
          "type": "string",
          "description": "Friend's display name",
          "maxLength": 80
        },
        "avatarConfigJson": {
          "type": "string",
          "description": "Serialized friend avatar config",
          "maxLength": 2048
        },
        "addedAt": {
          "type": "string",
          "description": "ISO timestamp when added as friend"
        }
      },
      "required": ["userId", "friendUserId", "friendName"]
    },
    "DirectMessage": {
      "title": "Direct Message",
      "description": "Private direct message between two coworkers",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique DM identifier",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "Sender Firebase Auth UID",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name",
          "maxLength": 80
        },
        "recipientId": {
          "type": "string",
          "description": "Recipient Firebase Auth UID",
          "maxLength": 128
        },
        "recipientName": {
          "type": "string",
          "description": "Recipient display name",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "Private message text content",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        },
        "read": {
          "type": "boolean",
          "description": "Whether message has been seen"
        }
      },
      "required": ["messageId", "senderId", "senderName", "recipientId", "recipientName", "text", "timestamp"]
    },
    "RoomChatMessage": {
      "title": "Room Chat Message",
      "description": "Public chat message broadcast within a specific room and server",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique chat message ID",
          "maxLength": 128
        },
        "roomId": {
          "type": "string",
          "description": "Room server ID",
          "maxLength": 80
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name",
          "maxLength": 80
        },
        "avatarSeed": {
          "type": "string",
          "description": "Avatar style identifier or emoji",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "description": "Chat message text",
          "maxLength": 500
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        }
      },
      "required": ["id", "roomId", "senderId", "senderName", "message", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile, tickets, focus stats, and customization"
    },
    "/users/{userId}/books/{bookId}": {
      "schema": "BookshelfItem",
      "description": "Stores personal bookshelf items, reading status, bookmarks, and notes"
    },
    "/users/{userId}/friends/{friendUserId}": {
      "schema": "Friendship",
      "description": "Stores coworker friend connections"
    },
    "/cafe_notes/{noteId}": {
      "schema": "CafeSharedNote",
      "description": "Stores public sticky notes and book recommendations left by coworkers"
    },
    "/room_presences/{presenceId}": {
      "schema": "RoomPresence",
      "description": "Stores live active coworker presences and desk positions per room and server"
    },
    "/direct_messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Stores real-time 1-on-1 private messages between coworkers"
    },
    "/room_chats/{chatId}": {
      "schema": "RoomChatMessage",
      "description": "Stores room-specific real-time chat messages"
    }
  }
}
